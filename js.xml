<section id="live-result" class="level2">
<h2 class="anchored" data-anchor-id="live-result">Live result</h2>
<p>Here’s exactly that code, running on this page:</p>
<link href="https://cdn.jsdelivr.net/gh/neuhausi/canvasXpress@69.6.1/inst/htmlwidgets/lib/canvasXpress/canvasXpress.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/gh/neuhausi/canvasXpress@69.6.1/inst/htmlwidgets/lib/canvasXpress/canvasXpress.min.js"></script>
<canvas id="volcanoLive" width="650" height="500"></canvas>
<script>
(function () {
  function draw() {
    if (typeof CanvasXpress === "undefined") { return setTimeout(draw, 60); }
    var genes = [], logFC = [], negLogP = [], group = [], fc = [];
    for (var i = 0; i < 1000; i++) {
      var f = (Math.random() * 2 - 1) * 2.2;
      var p = -Math.log(Math.random()) / Math.LN10 * 1.5;
      genes.push("Gene" + (i + 1));
      logFC.push(Math.round(f * 1000) / 1000);
      negLogP.push(Math.round(p * 1000) / 1000);
      group.push(f > 1 && p > 2 ? "Increased" : f < -1 && p > 2 ? "Decreased" : "NoChange");
      fc.push(Math.round(Math.pow(2, Math.abs(f)) * 100) / 100);
    }
    new CanvasXpress("volcanoLive",
      { y: { vars: ["logFC", "-log-pVal"], smps: genes, data: [logFC, negLogP] },
        z: { Group: group, FC: fc } },
      { graphType: "Scatter2D", title: "Publication-ready volcano plot",
        xAxis: ["logFC"], yAxis: ["-log-pVal"],
        xAxisTitle: "log2 fold change", yAxisTitle: "-log10 p-value",
        colorBy: "Group",
        colorKey: { Group: { Increased: "rgba(197,27,38,0.75)", Decreased: "rgba(33,102,172,0.75)", NoChange: "rgba(150,150,150,0.35)" } },
        sizeBy: "FC", sizes: [3, 6, 9, 12, 15], showDecorations: true,
        decorations: { line: [ { color: "rgba(120,120,120,0.8)", width: 1, x: 1 }, { color: "rgba(120,120,120,0.8)", width: 1, x: -1 }, { color: "rgba(120,120,120,0.8)", width: 1, y: 1.301 } ] } });
  }
  draw();
})();
</script>
<p>Hover a point for its gene and values, drag to zoom, or use the toolbar to filter by regulation group. The dashed guides mark the ±1 log2FC and p = 0.05 cutoffs.</p>
</section>
<section id="why-reproducible" class="level2">
<h2 class="anchored" data-anchor-id="why-reproducible">Why “reproducible”</h2>
<p>The <code>data</code> and <code>config</code> above <strong>are</strong> the figure — one portable JSON specification. Save it and the identical plot renders from the R (<code>canvasXpress</code>) and Python (<code>canvasxpress</code>) packages, and it can be validated against a published schema and re-rendered later, so a figure can be regenerated and audited rather than just viewed.</p>
</section>
