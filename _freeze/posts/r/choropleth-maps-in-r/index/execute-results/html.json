.69\",\"Q2: 0.564 - 2.69\",\"Q5: 22.4 - 46\",\"Q1: 0.00765 - 0.564\",\"Q4: 7.8 - 22.4\",\"Q4: 7.8 - 22.4\",\"Q2: 0.564 - 2.69\",\"Q3: 2.69 - 7.8\",\"Q2: 0.564 - 2.69\",\"Q7: 208 - 9.96e+03\",\"Q2: 0.564 - 2.69\",\"Q3: 2.69 - 7.8\",\"Q2: 0.564 - 2.69\",\"Q1: 0.00765 - 0.564\",\"Q3: 2.69 - 7.8\",\"Q3: 2.69 - 7.8\",\"Q7: 208 - 9.96e+03\",\"Q3: 2.69 - 7.8\",\"Q6: 46 - 208\",\"Q2: 0.564 - 2.69\",\"Q6: 46 - 208\",\"Q4: 7.8 - 22.4\",\"Q5: 22.4 - 46\",\"Q3: 2.69 - 7.8\",\"Q1: 0.00765 - 0.564\",\"Q4: 7.8 - 22.4\",\"Q6: 46 - 208\",\"Q4: 7.8 - 22.4\",\"Q5: 22.4 - 46\",\"Q3: 2.69 - 7.8\",\"Q2: 0.564 - 2.69\",\"Q6: 46 - 208\",\"Q1: 0.00765 - 0.564\",\"Q5: 22.4 - 46\",\"Q3: 2.69 - 7.8\",\"Q5: 22.4 - 46\",\"Q6: 46 - 208\",\"Q7: 208 - 9.96e+03\",\"Q4: 7.8 - 22.4\",\"Q3: 2.69 - 7.8\",\"Q4: 7.8 - 22.4\",\"Q6: 46 - 208\",\"Q6: 46 - 208\",\"Q7: 208 - 9.96e+03\",\"Q6: 46 - 208\",\"Q6: 46 - 208\",\"Q6: 46 - 208\",\"Q7: 208 - 9.96e+03\",\"Q2: 0.564 - 2.69\",\"Q1: 0.00765 - 0.564\",\"Q1: 0.00765 - 0.564\",\"Q1: 0.00765 - 0.564\",\"Q1: 0.00765 - 0.564\",\"Q1: 0.00765 - 0.564\",\"Q1: 0.00765 - 0.564\",\"Q1: 0.00765 - 0.564\",\"Q7: 208 - 9.96e+03\",\"Q6: 46 - 208\",\"Q2: 0.564 - 2.69\",\"Q2: 0.564 - 2.69\",\"Q5: 22.4 - 46\",\"Q5: 22.4 - 46\",\"Q4: 7.8 - 22.4\",\"Q1: 0.00765 - 0.564\",\"Q2: 0.564 - 2.69\",\"Q7: 208 - 9.96e+03\",\"Q2: 0.564 - 2.69\",\"Q7: 208 - 9.96e+03\",\"Q5: 22.4 - 46\",\"Q5: 22.4 - 46\",\"Q2: 0.564 - 2.69\",\"Q5: 22.4 - 46\",\"Q5: 22.4 - 46\",\"Q5: 22.4 - 46\",\"Q7: 208 - 9.96e+03\",\"Q3: 2.69 - 7.8\",\"Q4: 7.8 - 22.4\",\"Q7: 208 - 9.96e+03\",\"Q1: 0.00765 - 0.564\",\"Q3: 2.69 - 7.8\",\"Q1: 0.00765 - 0.564\",\"Q5: 22.4 - 46\",\"Q5: 22.4 - 46\",\"Q7: 208 - 9.96e+03\",\"Q6: 46 - 208\",\"Q1: 0.00765 - 0.564\",\"Q3: 2.69 - 7.8\",\"Q7: 208 - 9.96e+03\",\"Q6: 46 - 208\",\"Q7: 208 - 9.96e+03\",\"Q7: 208 - 9.96e+03\",\"Q3: 2.69 - 7.8\",\"Q6: 46 - 208\",\"Q1: 0.00765 - 0.564\",\"Q6: 46 - 208\",\"Q7: 208 - 9.96e+03\",\"Q4: 7.8 - 22.4\",\"Q3: 2.69 - 7.8\",\"Q4: 7.8 - 22.4\"]},\"z\":null},\"config\":{\"graphType\":\"Map\",\"isR\":true,\"colorBy\":\"CO2\",\"topoJSON\":\"https://www.canvasxpress.org/data/maps/WORLD.json\",\"mapId\":\"co2Linear\",\"legendPosition\":\"left\",\"theme\":\"solarized\",\"title\":\"The same data on a plain linear ramp\",\"subtitle\":\"195 of 198 countries sit in the bottom fifth of the scale - the map goes flat\"},\"events\":null,\"afterRender\":null},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n\nThis is the single most common choropleth failure. The cure is **classing**:\n\n- `colorSpectrumBreaksMethod = \"quantile\"` — equal *counts* per class. Every colour is used, by\n  construction. The right default for skewed data and for \"which regions rank high/low\" questions.\n- `colorSpectrumBreaksMethod = \"jenks\"` — natural breaks that minimise within-class variance. Best\n  when the data has genuine clusters with gaps between them; on smoothly heavy-tailed data like this\n  it piles almost everything into the bottom class, so check the legend before you trust it.\n- Three to seven classes is the usable range — beyond that, readers cannot match colours to the\n  legend.\n\n## Choose the palette on purpose\n\nThe palette is not decoration — it is the scale's grammar:\n\n- **Sequential** (dark → light of ordered hues, like viridis above) for a quantity that only goes\n  up: counts, rates, concentrations.\n- **Diverging** (two hues meeting at a neutral midpoint) when values are meaningful *above and below\n  a reference*: change vs. last year, difference from a target, a signed index. Give canvasXpress a\n  three-colour `colorSpectrum` and pin the midpoint with `colorSpectrumZeroValue`:\n\n  ```r\n  colorBy = \"Change\",\n  colorSpectrum = list(\"#2166ac\", \"#f7f7f7\", \"#b2182b\"),  # blue - neutral - red\n  colorSpectrumZeroValue = 0                               # value mapped to the middle colour\n  ```\n\n  Never use a diverging palette for a purely positive quantity — the neutral midpoint invents a\n  \"normal\" that the data does not have.\n\nViridis and the ColorBrewer ramps are colour-blind-safe and perceptually ordered; a rainbow ramp is\nneither, so readers cannot tell which end means \"more\". Keep the *same* scale across small multiples\nso maps stay comparable.\n\n## Polish: legend, labels and base styling\n\n- `subtitle` / `source` — caption the units and provenance.\n- `legendNumberFormat = list(style = \"decimal\", decimals = 1, suffix = \"%\")` — format the legend\n  ticks as percentages, currency, etc.\n- `mapColor` / `mapOutlineColor` — the fill for regions with **no data** (a neutral grey) and the\n  border between shapes, so missing data reads as missing rather than as a value.\n- `showMapLabels = TRUE` — draw region names (best on maps with few regions, e.g. a single country's\n  provinces; it clutters a 190-country world map).\n- `legendInside = TRUE` — float the legend over empty ocean to reclaim width.\n\n## Beyond the world map\n\n- **Other boundaries.** Point `topoJSON` at any shape file — US states, a single country's regions,\n  counties, custom districts. The join key is just the shape name.\n- **Projection.** `mapProjection = \"albers\"` (equal-area, good for the US) or `\"mercator\"`. Equal-area\n  projections matter for choropleths: Mercator inflates high latitudes, exaggerating those regions'\n  visual weight.\n- **Categorical maps.** Point `colorBy` at a categorical column (an election winner, a priority tier)\n  for a qualitative choropleth with a discrete legend.\n- **Markers.** Add `decorations` to drop labelled points on cities or call out specific regions.\n\nThe whole figure — data, boundaries, classing rule and palette — travels together as one spec, so a\nreviewer can reproduce it exactly and a colleague can re-render it from Python or JavaScript.\n\n## Next\n\n- [Choropleth maps in Python](../choropleth-maps-in-python/)\n- [Choropleth maps in JavaScript](../choropleth-maps-in-javascript/)\n- [Clustered heatmaps in R](../clustered-heatmap-in-r/)\n- Gallery: <https://canvasxpress.org/examples.html>\n",
