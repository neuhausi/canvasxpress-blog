E, xAxis = list(\"value\"),\n  smpTitle = \"Dose\", title = \"Control vs Treated — split violin by dose\",\n  width = 650, height = 500\n)\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div id=\"htmlwidget-d26bfe112ba61c5aa31f\" style=\"width:100%;height:500px;\" class=\"canvasXpress html-widget\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-d26bfe112ba61c5aa31f\">{\"x\":{\"data\":{\"y\":{\"vars\":[\"value\"],\"smps\":[\"o1\",\"o2\",\"o3\",\"o4\",\"o5\",\"o6\",\"o7\",\"o8\",\"o9\",\"o10\",\"o11\",\"o12\",\"o13\",\"o14\",\"o15\",\"o16\",\"o17\",\"o18\",\"o19\",\"o20\",\"o21\",\"o22\",\"o23\",\"o24\",\"o25\",\"o26\",\"o27\",\"o28\",\"o29\",\"o30\",\"o31\",\"o32\",\"o33\",\"o34\",\"o35\",\"o36\",\"o37\",\"o38\",\"o39\",\"o40\",\"o41\",\"o42\",\"o43\",\"o44\",\"o45\",\"o46\",\"o47\",\"o48\",\"o49\",\"o50\",\"o51\",\"o52\",\"o53\",\"o54\",\"o55\",\"o56\",\"o57\",\"o58\",\"o59\",\"o60\",\"o61\",\"o62\",\"o63\",\"o64\",\"o65\",\"o66\",\"o67\",\"o68\",\"o69\",\"o70\",\"o71\",\"o72\",\"o73\",\"o74\",\"o75\",\"o76\",\"o77\",\"o78\",\"o79\",\"o80\",\"o81\",\"o82\",\"o83\",\"o84\",\"o85\",\"o86\",\"o87\",\"o88\",\"o89\",\"o90\",\"o91\",\"o92\",\"o93\",\"o94\",\"o95\",\"o96\",\"o97\",\"o98\",\"o99\",\"o100\",\"o101\",\"o102\",\"o103\",\"o104\",\"o105\",\"o106\",\"o107\",\"o108\",\"o109\",\"o110\",\"o111\",\"o112\",\"o113\",\"o114\",\"o115\",\"o116\",\"o117\",\"o118\",\"o119\",\"o120\",\"o121\",\"o122\",\"o123\",\"o124\",\"o125\",\"o126\",\"o127\",\"o128\",\"o129\",\"o130\",\"o131\",\"o132\",\"o133\",\"o134\",\"o135\",\"o136\",\"o137\",\"o138\",\"o139\",\"o140\",\"o141\",\"o142\",\"o143\",\"o144\",\"o145\",\"o146\",\"o147\",\"o148\",\"o149\",\"o150\",\"o151\",\"o152\",\"o153\",\"o154\",\"o155\",\"o156\",\"o157\",\"o158\",\"o159\",\"o160\",\"o161\",\"o162\",\"o163\",\"o164\",\"o165\",\"o166\",\"o167\",\"o168\",\"o169\",\"o170\",\"o171\",\"o172\",\"o173\",\"o174\",\"o175\",\"o176\",\"o177\",\"o178\",\"o179\",\"o180\",\"o181\",\"o182\",\"o183\",\"o184\",\"o185